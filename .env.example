PORT=3000

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# WhatsApp provider: cloud or green
WHATSAPP_PROVIDER=cloud
ADMIN_PHONE=+77711126089

# WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=your_meta_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Green API
GREEN_API_ID_INSTANCE=your_green_instance_id
GREEN_API_TOKEN=your_green_api_token
# alias supported: GREEN_API_TOKEN_INSTANCE
GREEN_API_BASE_URL=https://api.green-api.com

# Webhook URL in Green API cabinet: https://your-domain/webhook
WEBHOOK_TEST_REPLY=false

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Webhook security
WEBHOOK_REQUIRE_SIGNATURE=false
WHATSAPP_APP_SECRET=your_meta_app_secret
GREEN_WEBHOOK_SECRET=your_green_webhook_secret

# Booking intent NLP (local + optional AI for borderline cases)
BOOKING_INTENT_AI=true

# Logging
LOG_DIR=logs
LOG_FILE=logs/app.log
LOG_LEVEL=info

# Google Sheets CRM
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_TAB=Leads
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
# or inline credentials:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Optional external CRM webhook
CRM_WEBHOOK_URL=
